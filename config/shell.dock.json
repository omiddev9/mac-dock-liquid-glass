{
  "id": "io.github.omiddev9.mac-dock-liquid-glass",
  "edge": "bottom",
  "align": "center",
  "iconSize": 44,
  "zoom": 0.48,
  "gaussianZoom": true,
  "magnify": true,
  "spacing": 4,
  "padding": 8,
  "backgroundOpacity": 0.75,
  "iconOpacity": 1.0,
  "tiles": false,
  "tileOpacity": 0.15,
  "border": true,
  "glass": true,
  "glassColor": "#0b0b10",
  "glassTint": 0.34,
  "glassEdge": 1.0,
  "glassRadius": 0.30,
  "macIcons": true,
  "macIconTheme": "MacTahoe",
  "matchBarOpacity": false,
  "matchBarCorners": false,
  "matchBarGlow": false,
  "glow": false,
  "glowAmount": 0.5,
  "glowFocus": "full",
  "autohide": true,
  "dodge": true,
  "pressure": true,
  "hotspotHeight": 6,
  "showWhenEmpty": true,
  "runningIndicator": "dot",
  "labels": true,
  "tintIcons": false,
  "tintRunning": true,
  "monochrome": false,
  "items": [
    {
      "showApps": true,
      "label": "Omarchy Menu",
      "tint": true
    },
    {
      "desktop": "org.gnome.Nautilus"
    },
    {
      "desktop": "kitty"
    },
    {
      "desktop": "vivaldi-stable"
    }
  ]
}
